# systemd unit for the sync server of Tephra.
#
#   sudo install -m 0755 target/release/tephra-server /usr/local/bin/tephra-server
#   sudo useradd --system --user-group --home-dir /var/lib/tephra-server --shell /usr/sbin/nologin tephra-server
#   sudo install -m 0644 deploy/tephra-server.service /etc/systemd/system/tephra-server.service
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now tephra-server
#
# Invite code for a new account:
#   sudo -u tephra-server tephra-server --db /var/lib/tephra-server/tephra-server.sqlite invite
#
# The server speaks plain HTTP on 127.0.0.1:8787. Put a reverse proxy with TLS in front of it
# (see the Caddyfile next to this file).

[Unit]
Description=Tephra sync server
Documentation=https://github.com/Poldion/Tephra
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=tephra-server
Group=tephra-server
ExecStart=/usr/local/bin/tephra-server serve
Environment=TEPHRA_SERVER_DB=/var/lib/tephra-server/tephra-server.sqlite
Environment=TEPHRA_SERVER_BIND=127.0.0.1:8787
Environment=TEPHRA_SERVER_REGISTRATION=invite
# The reverse proxy sets X-Forwarded-For; login attempts are limited per address from that header.
# Remove this line if nothing but the server itself sets that header.
Environment=TEPHRA_SERVER_BEHIND_PROXY=true
Environment=TEPHRA_SERVER_TLS=off
StateDirectory=tephra-server
StateDirectoryMode=0700
WorkingDirectory=/var/lib/tephra-server
UMask=0077
Restart=on-failure
RestartSec=5

# Hardening: the service needs its state directory and the network, nothing else.
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RemoveIPC=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources

[Install]
WantedBy=multi-user.target
